rules_version = '2';

// Reglas de seguridad de la web de la comunión de Vera.
// Los invitados pueden ESCRIBIR confirmaciones y mensajes, y reservar regalos,
// pero solo los organizadores (lista de abajo) pueden LEER los datos privados.
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Pon aquí los mismos correos que en public/js/config.js (admins)
    function esAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['veracomunion@gmail.com'];
    }

    function texto(campo, max) {
      return campo is string && campo.size() <= max;
    }

    // Ajustes de la web: todos los leen, solo los organizadores los cambian
    match /ajustes/{doc} {
      allow read: if true;
      allow write: if esAdmin()
                   && request.resource.data.keys().hasOnly(['tema', 'selector'])
                   && request.resource.data.tema is string
                   && request.resource.data.selector is bool;
    }

    // Confirmaciones de asistencia (privadas)
    match /confirmaciones/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['familia', 'asiste', 'personas', 'alergias', 'telefono', 'comentarios', 'fecha'])
                    && texto(request.resource.data.familia, 80)
                    && request.resource.data.familia.size() > 0
                    && request.resource.data.asiste is bool
                    && request.resource.data.personas is list
                    && request.resource.data.personas.size() <= 20
                    && texto(request.resource.data.alergias, 300)
                    && texto(request.resource.data.telefono, 20)
                    && texto(request.resource.data.comentarios, 500)
                    && request.resource.data.fecha == request.time;
      allow read, update, delete: if esAdmin();
    }

    // Regalos reservados: público (solo se sabe QUÉ está reservado, no quién)
    match /reservas/{regalo} {
      allow read: if true;
      // "create" solo funciona si el documento no existe: nadie puede pisar una reserva.
      allow create: if request.resource.data.keys().hasOnly(['fecha'])
                    && request.resource.data.fecha == request.time
                    && existsAfter(/databases/$(database)/documents/reservasDetalle/$(regalo));
      allow update, delete: if esAdmin();
    }

    // Quién ha reservado cada regalo (privado)
    match /reservasDetalle/{regalo} {
      allow create: if request.resource.data.keys().hasOnly(['regalo', 'nombre', 'fecha'])
                    && request.resource.data.regalo == regalo
                    && texto(request.resource.data.nombre, 80)
                    && request.resource.data.nombre.size() > 0
                    && request.resource.data.fecha == request.time
                    && existsAfter(/databases/$(database)/documents/reservas/$(regalo));
      allow read, update, delete: if esAdmin();
    }

    // Fotos de los invitados (públicas). Miniatura en "fotos", imagen grande en "fotosGrandes".
    match /fotos/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['nombre', 'mini', 'ancho', 'alto', 'fecha'])
                    && texto(request.resource.data.nombre, 60)
                    && request.resource.data.mini is string
                    && request.resource.data.mini.size() < 150000
                    && request.resource.data.ancho is int
                    && request.resource.data.alto is int
                    && request.resource.data.fecha == request.time
                    && existsAfter(/databases/$(database)/documents/fotosGrandes/$(id));
      // Cualquiera puede sumar 1 al contador de comentarios; el resto, solo admin.
      allow update: if esAdmin()
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comentarios'])
                        && request.resource.data.comentarios == resource.data.get('comentarios', 0) + 1);
      allow delete: if esAdmin();

      match /comentarios/{comentario} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['nombre', 'texto', 'fecha'])
                      && texto(request.resource.data.nombre, 60)
                      && request.resource.data.nombre.size() > 0
                      && texto(request.resource.data.texto, 300)
                      && request.resource.data.texto.size() > 0
                      && request.resource.data.fecha == request.time;
        allow update, delete: if esAdmin();
      }
    }

    // Para que el panel pueda listar todos los comentarios de todas las fotos
    match /{ruta=**}/comentarios/{comentario} {
      allow read: if true;
    }

    match /fotosGrandes/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['imagen', 'fecha'])
                    && request.resource.data.imagen is string
                    && request.resource.data.imagen.size() < 1000000
                    && request.resource.data.fecha == request.time
                    && existsAfter(/databases/$(database)/documents/fotos/$(id));
      allow update, delete: if esAdmin();
    }

    // Libro de mensajes (público)
    match /mensajes/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['nombre', 'texto', 'fecha'])
                    && texto(request.resource.data.nombre, 60)
                    && request.resource.data.nombre.size() > 0
                    && texto(request.resource.data.texto, 500)
                    && request.resource.data.texto.size() > 0
                    && request.resource.data.fecha == request.time;
      allow update, delete: if esAdmin();
    }
  }
}
